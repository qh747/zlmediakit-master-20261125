#!/bin/sh
#
# 推送到 origin 之前的两道本地检查。服务端是第三道，见 AGENTS.md。
#
# 1. remote 白名单
#    upstream 是 ZLMediaKit 官方基线，只读。本 hook 是第二道防线，第一道是
#    remote.upstream.pushurl=disabled://blocked，它让 upstream 在解析阶段就
#    不是合法 remote。本 hook 只负责在建立网络连接之前失败，并给出人能读懂的
#    原因。
#
# 2. ref 规则
#    - refs/heads/master 拒绝。master 是发布分支，只能通过合并验证过的分支
#      进入。发版时的显式覆盖命令见 AGENTS.md 的「分支」段。
#    - refs/tags/* 必须匹配 RELEASE-V<主>.<次>.<修>-<YYYYMMDD>，且日期真实
#      存在。校验不通过就拒绝。
#    - 删除远端 ref 时 stdin 首字段为 (delete)，此时跳过名字校验，否则旧
#      tag 永远删不掉。
#
# 已知限制：git push --no-verify 会跳过本 hook。这是 git 的既定行为，无法从
# hook 内部阻止。不可绕过的防线是 pushurl 与服务端分支保护。
#
# $1 = remote 名
# $2 = remote 的 push URL（已解析）

set -u

remote_name="${1:-}"
remote_url="${2:-}"

TAG_RE='^refs/tags/RELEASE-V[1-9][0-9]*\.[0-9]+\.[0-9]+-[0-9]{8}$'

# 纯 shell 日期校验。不用 date -d，那是 GNU 专有语法，macOS 的 BSD date 会
# 直接报 invalid option。这里只判断年月日是否真实存在，闰年也正确处理。
is_valid_date() {
    d=$1
    case "$d" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) ;;
    *) return 1 ;;
    esac
    y=${d%????}
    rest=${d#????}
    m=${rest%??}
    dd=${rest#??}
    case "$m" in
    01|03|05|07|08|10|12) max=31 ;;
    04|06|09|11) max=30 ;;
    02)
        if [ $((y % 400)) -eq 0 ] || { [ $((y % 4)) -eq 0 ] && [ $((y % 100)) -ne 0 ]; }; then
            max=29
        else
            max=28
        fi
        ;;
    *) return 1 ;;
    esac
    case "$dd" in
    0[1-9]|1[0-9]|2[0-9]|3[01]) ;;
    *) return 1 ;;
    esac
    [ "$dd" -le "$max" ]
}

# --- 1. remote 白名单 ----------------------------------------------------

case "$remote_name" in
origin)
    ;;
"")
    echo "pre-push: 未收到 remote 名，拒绝推送。" >&2
    exit 1
    ;;
*)
    {
        echo "pre-push: 拒绝推送到 '$remote_name'。"
        echo "          推送目标: $remote_url"
        echo "          本仓库只允许推送到 origin。"
        echo "          upstream 是只读基线，只能拉取，不能推送。"
        echo "          如确需推送，请显式使用: git push origin <ref>"
    } >&2
    exit 1
    ;;
esac

# --- 2. ref 规则 ---------------------------------------------------------
#
# stdin 每行格式：<本地 ref> <本地 sha> <远端 ref> <远端 sha>
# 删除远端 ref 时本地 ref 为字面量 (delete)。

failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${remote_ref:-}" ] || continue

    # 删除远端 ref 时，只有删除发布分支需要拦。删 tag 必须放行，否则旧 tag
    # 永远删不掉，发版时的重命名会卡死。
    if [ "$local_ref" = "(delete)" ]; then
        if [ "$remote_ref" = "refs/heads/master" ]; then
            echo "pre-push: 拒绝删除远端 refs/heads/master。" >&2
            failed=1
        fi
        continue
    fi

    case "$remote_ref" in
    refs/heads/master)
        {
            echo "pre-push: 拒绝更新 refs/heads/master。"
            echo "          master 是发布分支，只能合入验证过的分支。"
            echo "          日常开发推到 feature/develop，基线合并走 feature/merge_upstream。"
            echo "          发版覆盖命令见 AGENTS.md 的「分支」段。"
        } >&2
        failed=1
        ;;
    refs/tags/*)
        if ! printf '%s' "$remote_ref" | grep -qE "$TAG_RE"; then
            {
                echo "pre-push: 拒绝推送 tag '$remote_ref'。"
                echo "          格式必须是 RELEASE-V<主>.<次>.<修>-<YYYYMMDD>"
                echo "          示例: RELEASE-V1.0.0-20261126"
            } >&2
            failed=1
            continue
        fi
        tag_date=${remote_ref##*-}
        if ! is_valid_date "$tag_date"; then
            echo "pre-push: 拒绝推送 tag '$remote_ref'。日期 '$tag_date' 不存在。" >&2
            failed=1
        fi
        ;;
    esac
done

[ "$failed" -eq 1 ] && exit 1
exit 0
